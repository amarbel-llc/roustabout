# vim: ft=toml
#
# spinclass sweatfile for a conformist-adopting repo (the #eng template).

[hooks]
# Pre-merge gate: `just` runs this repo's default recipe (the CI-equivalent
# lane — build + the conformance checks). See eng-design_patterns-justfile(7).
pre-merge = "just"

# Per-commit repair (conformist#47/#51): format the index-staged content at
# authoring time so every commit is conformant. This names `conformist-pre-commit`
# — the CONFIG-SPECIFIC, TOOLCHAIN-HERMETIC hook this template exposes from
# `eval.config.build.preCommit` (flake.nix), placed on the devShell PATH under
# that name. It wraps `conformist --staged --exit-zero-on-fix` with this repo's
# generated store-path config, so the staged repair formats *.nix/*.go/etc. with
# the SAME pinned formatters as `nix fmt`.
#
# Do NOT use a bare `pre-commit = "conformist --staged --exit-zero-on-fix"` here:
# that resolves formatters from PATH, and if your shell lacks gofumpt/nixfmt/…
# the staged repair SILENTLY SKIPS those file types (conformist#51). The
# `conformist-pre-commit` wrapper avoids that — its tools are store-pinned.
#
# Requires the devShell active (direnv) so `conformist-pre-commit` is on PATH.
pre-commit = "conformist-pre-commit"

# Merge-time repair (conformist#54). Runs `conformist --commit --amend
# --exit-zero-on-fix` as a spinclass pre-merge repair hook: it repairs the
# worktree and folds the fixes into HEAD before the pre-merge gate.
# `conformist-repair` is the CONFIG-SPECIFIC, TOOLCHAIN-HERMETIC wrapper this
# template exposes from `eval.config.build.repair` (flake.nix), on the
# devShell PATH under that name. Enabled alongside `pre-commit` above (which
# already keeps the tree conformant at authoring time) so a commit made
# without the devShell active — or with a stale pre-commit hook — still
# converges at merge time. `--amend` re-signs HEAD: if the signing agent
# (piggy-agent) is locked, the merge's repair phase fails and needs it
# unlocked, same as any other signed commit.
repair = "conformist-repair"
